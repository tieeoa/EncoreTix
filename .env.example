# ===== Supabase (legacy — tidak dipakai runtime) =====
# Runtime database memakai MySQL lokal. Nilai di bawah hanya placeholder.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===== MySQL lokal (Laragon) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=encoretix

# ===== Autentikasi admin =====
# Wajib diisi dengan string acak panjang. Jangan pakai nilai bawaan di produksi.
AUTH_SECRET=your-random-auth-secret

# ===== Midtrans (opsional, untuk transaksi asli) =====
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# Tidak dipakai runtime; URL Snap ditentukan di src/app/lib/midtransSnap.ts
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
# Callback Midtrans. Contoh: https://namadomain.com
NEXT_PUBLIC_APP_URL=https://contoh-domain.com
# Dipakai sebagai origin fallback pada tautan email
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Email (kirim e-tiket & bukti merch ke pembeli) =====
# Untuk Gmail: buat App Password (2FA wajib aktif) lalu isi SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email.pengirim@gmail.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM=EncoreTix <email.pengirim@gmail.com>
# Tujuan kontak/CS jika berbeda dengan SMTP_USER
CONTACT_EMAIL=support@example.com

# ===== Google Gemini AI (asisten chat) =====
GEMINI_API_KEY=your_gemini_api_key_here
